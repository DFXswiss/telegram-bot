# Secrets only — at deploy time these are written from your secret store into .env.
# Non-secret config (PGHOST/PGPORT/PGUSER/PGDATABASE, LOG_LEVEL, intervals, ...)
# is set in the deployment's `environment:` block, not here.

# Telegram bot token from @BotFather. Privacy mode MUST be disabled
# (@BotFather -> /setprivacy -> Disable) so the bot receives all group messages.
TELEGRAM_BOT_TOKEN=CHANGE_ME

# Postgres password (the only DB secret; host/user/db/port are config).
PGPASSWORD=CHANGE_ME
